<?xml version="1.0"?>
<package format="3">
  <name>osmo360_driver</name>
  <version>0.1.0</version>
  <description>DJI Osmo 360 video, raw IMU and control over USB.</description>
  <maintainer email="hammersmithg1@users.noreply.github.com">hammersmithg1</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>launch_xml</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>python3-av</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
